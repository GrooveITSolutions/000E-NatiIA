    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.ANTHROPIC_MODEL || 'claude-sonnet-5', max_tokens: 1024, system: 'Interpretas pedidos de turno para un consultorio medico de PAMI. Devolves EXCLUSIVAMENTE JSON: {\"tipo_consulta\": string, \"duracion_minutos\": number, \"profesional\": string, \"preferencia\": string|null}. duracion_minutos tipico: consulta_general=20, control=15, practica=30. profesional por defecto \"default\" si no se especifica.', messages: [ { role: 'user', content: 'Mensaje del paciente: ' + $json.contenido } ] }) }}"
      },
      "id": "n046",
      "name": "Clasificar motivo de consulta (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $('Hay confirmacion pendiente?').first().json;\nconst resp = $input.first().json;\nlet datos = { tipo_consulta: 'consulta_general', duracion_minutos: 20, profesional: 'default', preferencia: null };\ntry {\n  const text = resp.content?.[0]?.text || '{}';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  datos = { ...datos, ...JSON.parse(match ? match[0] : text) };\n} catch (e) {}\nreturn [{ json: { ...item, ...datos } }];\n"
      },
      "id": "n047",
      "name": "Parsear motivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        260
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "={{$env.GOOGLE_CALENDAR_ID}}",
          "mode": "id"
        },
        "operation": "getAll",
        "returnAll": false,
        "limit": 100,
        "options": {
          "timeMin": "={{ new Date().toISOString() }}",
          "timeMax": "={{ new Date(Date.now() + 14*24*3600*1000).toISOString() }}"
        }
      },
      "id": "n048",
      "name": "Listar eventos del calendario",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        1220,
        260
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Calendar - Consultorio"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Parsear motivo').first().json;\nconst eventos = $input.all().map(i => i.json);\nconst duracion = ctx.duracion_minutos || 20;\n\nconst busy = eventos\n  .filter(e => e.start && e.end)\n  .map(e => ({\n    start: new Date(e.start.dateTime || e.start.date),\n    end: new Date(e.end.dateTime || e.end.date),\n  }));\n\nfunction overlaps(s, e) {\n  return busy.some(b => s < b.end && e > b.start);\n}\n\nconst opciones = [];\nconst now = new Date();\nfor (let d = 1; d <= 14 && opciones.length < 3; d++) {\n  const day = new Date(now);\n  day.setDate(day.getDate() + d);\n  const weekday = day.getDay(); // 0=domingo\n  if (weekday === 0 || weekday === 6) continue; // solo Lun-Vie\n\n  const bloques = [[9, 13], [15, 19]];\n  for (const [hIni, hFin] of bloques) {\n    for (let h = hIni * 60; h + duracion <= hFin * 60 && opciones.length < 3; h += duracion) {\n      const start = new Date(day);\n      start.setHours(0, 0, 0, 0);\n      start.setMinutes(h);\n      const end = new Date(start.getTime() + duracion * 60000);\n      if (start < now) continue;\n      if (!overlaps(start, end)) {\n        opciones.push({ start: start.toISOString(), end: end.toISOString() });\n      }\n    }\n  }\n}\n\nreturn [{ json: { ...ctx, opciones } }];\n"
      },
      "id": "n049",
      "name": "Calcular huecos libres",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst ctx = $input.first().json;\nconst dias = ['domingo','lunes','martes','miercoles','jueves','viernes','sabado'];\nconst meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];\n\nfunction fmt(iso) {\n  const d = new Date(iso);\n  return `${dias[d.getDay()]} ${d.getDate()} de ${meses[d.getMonth()]} a las ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;\n}\n\nlet texto;\nif (!ctx.opciones.length) {\n  texto = 'No encontré turnos disponibles en los próximos 14 días 😕. Te aviso apenas se libere uno, o podés llamar al consultorio.';\n} else {\n  const lineas = ctx.opciones.map((o, i) => `${i + 1}. ${fmt(o.start)}`);\n  texto = `Tengo estos turnos disponibles:\\n\\n${lineas.join('\\n')}\\n\\nRespondé con el número de la opción que preferís.`;\n}\n\nreturn [{ json: { ...ctx, mensaje_opciones: texto } }];\n"
      },
