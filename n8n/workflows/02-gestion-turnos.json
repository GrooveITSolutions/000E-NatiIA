    {
      "parameters": {
        "jsCode": "\nconst item = $('Hay confirmacion pendiente?').first().json;\nconst estado = item.estado_conversacion || {};\nconst opciones = estado.opciones || [];\nconst texto = (item.contenido || '').trim();\nconst n = parseInt(texto.match(/\\d+/)?.[0], 10);\nconst seleccion = (n && opciones[n - 1]) ? opciones[n - 1] : null;\n\nreturn [{\n  json: {\n    ...item,\n    seleccion,\n    seleccion_valida: !!seleccion,\n    es_oferta_lista_espera: estado.esperando === 'oferta_lista_espera',\n    lista_espera_id: estado.lista_espera_id || null,\n    tipo_consulta: estado.tipo_consulta || 'consulta_general',\n    profesional: estado.profesional || 'default',\n  }\n}];\n"
      },
