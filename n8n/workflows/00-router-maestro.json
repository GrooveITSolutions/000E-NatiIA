    {
      "parameters": {
        "jsCode": "\nconst normalizado = $('Normalizar mensaje').first().json;\nconst rows = $input.first().json;\nconst paciente = Array.isArray(rows) && rows.length ? rows[0] : null;\n\nreturn [{\n  json: {\n    ...normalizado,\n    paciente,\n    es_nuevo: !paciente,\n    onboarding_completo: paciente ? !!paciente.onboarding_completo : false,\n    en_manos_de_humano: paciente ? !!paciente.en_manos_de_humano : false,\n    estado_conversacion: paciente ? (paciente.estado_conversacion || {}) : {},\n  }\n}];\n"
      },
