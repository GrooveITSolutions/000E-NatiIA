    {
      "parameters": {
        "content": "ROUTER MAESTRO\n\nPunto de entrada unico de todo lo que llega por WhatsApp (Evolution API).\nClasifica el mensaje y dispara el sub-flujo correspondiente via Execute Workflow.\n\nConfigurar en Evolution API el webhook apuntando a esta URL.",
        "height": 180,
        "width": 380
      },
      "id": "n002",
      "name": "Nota 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.event}}",
              "rightValue": "messages.upsert",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n003",
      "name": "Filtrar eventos validos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $input.first().json;\nconst data = body.data || {};\nconst key = data.key || {};\nconst msg = data.message || {};\n\nconst telefono = (key.remoteJid || '').replace('@s.whatsapp.net', '').replace('@g.us', '');\n\nlet tipo = 'texto';\nlet contenido = '';\nlet media_url = null;\n\nif (msg.conversation) {\n  tipo = 'texto';\n  contenido = msg.conversation;\n} else if (msg.extendedTextMessage) {\n  tipo = 'texto';\n  contenido = msg.extendedTextMessage.text;\n} else if (msg.imageMessage) {\n  tipo = 'imagen';\n  contenido = msg.imageMessage.caption || '';\n  media_url = data.mediaUrl || msg.imageMessage.url || null;\n} else if (msg.audioMessage) {\n  tipo = 'audio';\n  media_url = data.mediaUrl || msg.audioMessage.url || null;\n} else if (msg.locationMessage) {\n  tipo = 'ubicacion';\n  contenido = JSON.stringify({lat: msg.locationMessage.degreesLatitude, lng: msg.locationMessage.degreesLongitude});\n} else if (msg.buttonsResponseMessage) {\n  tipo = 'texto';\n  contenido = msg.buttonsResponseMessage.selectedButtonId || msg.buttonsResponseMessage.selectedDisplayText;\n} else if (msg.listResponseMessage) {\n  tipo = 'texto';\n  contenido = msg.listResponseMessage.singleSelectReply?.selectedRowId || msg.listResponseMessage.title;\n}\n\nreturn [{\n  json: {\n    telefono,\n    tipo,\n    contenido,\n    media_url,\n    timestamp: data.messageTimestamp || Math.floor(Date.now() / 1000),\n  }\n}];\n"
      },
      "id": "n004",
      "name": "Normalizar mensaje",
