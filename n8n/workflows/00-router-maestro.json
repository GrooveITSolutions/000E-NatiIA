    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.ANTHROPIC_MODEL || 'claude-sonnet-5', max_tokens: 1024, system: 'Sos el clasificador de intenciones de la secretaria virtual de un consultorio medico de PAMI. Devolves EXCLUSIVAMENTE un JSON valido (sin texto adicional, sin markdown) con esta forma: {\"intent\": string, \"confidence\": number, \"entities\": object}. Los valores posibles de intent son: turno_nuevo, cancelar_turno, pregunta_general, pedido_receta, consulta_sintoma, hablar_con_humano, verificar_cobertura, otro.', messages: [ { role: 'user', content: =[ { type: 'text', text: 'Mensaje del paciente: ' + $json.contenido + '\\n\\nEstado de conversacion actual del paciente (por si esta respondiendo algo puntual): ' + JSON.stringify($json.estado_conversacion) } ] } ] }) }}"
      },
      "id": "n014",
      "name": "Clasificar intencion (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $('Tipo de contenido').first().json;\nconst resp = $input.first().json;\nlet intent = 'otro';\nlet confidence = 0;\nlet entities = {};\ntry {\n  const text = resp.content?.[0]?.text || '{}';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  const parsed = JSON.parse(match ? match[0] : text);\n  intent = parsed.intent || 'otro';\n  confidence = parsed.confidence ?? 0.5;\n  entities = parsed.entities || {};\n} catch (e) {\n  intent = 'otro';\n}\n\n// Si el paciente esta respondiendo a una oferta de turno/lista de espera pendiente, priorizar eso.\nconst estado = item.estado_conversacion || {};\nif (estado.esperando === 'confirmacion_turno' || estado.esperando === 'oferta_lista_espera') {\n  intent = 'turno_nuevo';\n  confidence = 1;\n}\n\nreturn [{ json: { ...item, intent, confidence, entities } }];\n"
      },
