      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst t = item.turno_cancelado;\nconst slot = { start: t.fecha_hora, end: new Date(new Date(t.fecha_hora).getTime() + (t.duracion_minutos || 20) * 60000).toISOString() };\nconst fecha = new Date(slot.start).toLocaleString('es-AR', { dateStyle: 'full', timeStyle: 'short' });\nreturn [{\n  json: {\n    telefono: item.candidato.pacientes.telefono,\n    paciente_id: item.candidato.pacientes.id,\n    lista_espera_id: item.candidato.id,\n    tipo_consulta: item.candidato.tipo_consulta,\n    profesional: item.candidato.profesional,\n    slot,\n    mensaje: `Se liberó un turno para el ${fecha}. ¿Lo querés? Respondé 1 para confirmarlo.`,\n  }\n}];\n"
      },
