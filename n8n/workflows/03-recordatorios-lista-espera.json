            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "and",
              "value": "={{$json.filtro_48h}}"
            },
            {
              "name": "select",
              "value": "*,pacientes(id,telefono,nombre_completo)"
            }
          ]
        }
      },
