        "jsonBody": "={{ JSON.stringify({ number: ={{$json.telefono}}, text: ={{ 'Esa práctica requiere trámite previo con PAMI. ' + ($json.practica.instrucciones || 'Te recomendamos consultar en tu agencia de PAMI antes del turno.') }} }) }}"
