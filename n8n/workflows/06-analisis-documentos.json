    {
      "parameters": {
        "jsCode": "\n// Placeholder: decodificar el codigo requiere una libreria de imagen (ej. jsQR / zxing)\n// que no viene incluida en el sandbox estandar de n8n. Dos opciones:\n//  1) Instalar un nodo comunitario de QR/Barcode y reemplazar este Code node.\n//  2) Delegar la lectura del codigo a un microservicio propio (HTTP Request) y\n//     dejar este nodo solo para combinar el resultado.\nconst item = $input.first().json;\nreturn [{ json: { ...item, codigo_detectado: null, nota: 'Pendiente: conectar libreria de QR/Barcode' } }];\n"
      },
      "id": "n115",
      "name": "Decodificar QR/codigo de barras",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        180
      ]
    },
    {
