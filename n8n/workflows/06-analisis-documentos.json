    {
      "parameters": {
        "content": "ANALISIS DE DOCUMENTOS\n\nSe dispara con cualquier foto de un paciente ya registrado que\nno sea DNI/credencial (eso lo maneja el Flujo 01). Clasifica el\ntipo de documento y aplica el prompt de vision especifico segun\ncorresponda (receta manuscrita, caja de medicamento, o un\ndocumento con QR/codigo de barras).",
        "height": 200,
        "width": 400
      },
      "id": "n107",
      "name": "Nota 8",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.media_url}}",
        "options": {}
      },
      "id": "n108",
      "name": "Descargar imagen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "notes": "Configurar 'Response Format' = File/Binary tras importar."
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first();\nconst binary = item.binary?.data;\nif (!binary) throw new Error('No se recibio imagen binaria.');\nreturn [{ json: { ...item.json, image_base64: binary.data, mime_type: binary.mimeType || 'image/jpeg' } }];\n"
      },
      "id": "n109",
      "name": "Convertir a base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.ANTHROPIC_MODEL || 'claude-sonnet-5', max_tokens: 1024, system: 'Clasificas fotos de papeles que envian pacientes a un consultorio medico de PAMI. Respondes EXCLUSIVAMENTE JSON: {\"tipo_documento\": \"orden_laboratorio|derivacion|receta_manuscrita|medicamento|certificado|otro\", \"tiene_codigo\": boolean}.', messages: [ { role: 'user', content: [ { type: 'text', text: 'Clasifica este documento.' }, { type: 'image', source: { type: 'base64', media_type: $json.mime_type, data: $json.image_base64 } } ] } ] }) }}"
      },
      "id": "n110",
      "name": "Clasificar documento (Claude Vision)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst prev = $('Convertir a base64').first().json;\nconst resp = $input.first().json;\nlet datos = { tipo_documento: 'otro', tiene_codigo: false };\ntry {\n  const text = resp.content?.[0]?.text || '{}';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  datos = { ...datos, ...JSON.parse(match ? match[0] : text) };\n} catch (e) {}\nlet ruta = datos.tipo_documento;\nif (datos.tiene_codigo) ruta = 'con_codigo';\nreturn [{ json: { ...prev, ...datos, ruta } }];\n"
      },
      "id": "n111",
      "name": "Parsear clasificacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        0
      ]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "receta_manuscrita",
                    "leftValue": "={{$json.ruta}}",
                    "rightValue": "receta_manuscrita",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "receta_manuscrita"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "medicamento",
                    "leftValue": "={{$json.ruta}}",
                    "rightValue": "medicamento",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "medicamento"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "con_codigo",
                    "leftValue": "={{$json.ruta}}",
                    "rightValue": "con_codigo",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "con_codigo"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "otro"
        }
      },
