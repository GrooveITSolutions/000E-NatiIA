        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.ANTHROPIC_MODEL || 'claude-sonnet-5', max_tokens: 1024, system: 'Digitalizas ordenes/derivaciones medicas manuscritas para un consultorio de PAMI en Argentina. Respondes EXCLUSIVAMENTE JSON: {\"diagnostico\": string|null, \"estudio_solicitado\": string|null, \"medico_derivante\": string|null, \"especialidad_derivada\": string|null}.', messages: [ { role: 'user', content: [ { type: 'text', text: 'Extrae los datos de esta orden/derivacion manuscrita.' }, { type: 'image', source: { type: 'base64', media_type: $json.mime_type, data: $json.image_base64 } } ] } ] }) }}"
      },
