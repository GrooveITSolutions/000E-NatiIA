        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.ANTHROPIC_MODEL || 'claude-sonnet-5', max_tokens: 1024, system: 'Leés etiquetas de cajas/blisteres de medicamentos. Respondes EXCLUSIVAMENTE JSON: {\"droga\": string|null, \"marca\": string|null, \"mg\": string|null, \"cantidad_comprimidos\": string|null}.', messages: [ { role: 'user', content: [ { type: 'text', text: 'Extrae los datos de esta caja de medicamento.' }, { type: 'image', source: { type: 'base64', media_type: $json.mime_type, data: $json.image_base64 } } ] } ] }) }}"
      },
      "id": "n114",
      "name": "Claude Vision - Leer medicamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        -20
