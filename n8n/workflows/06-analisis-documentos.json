        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.ANTHROPIC_MODEL || 'claude-sonnet-5', max_tokens: 1024, system: 'Extraes el texto relevante (numero de tramite, autorizacion, practica solicitada) de un documento medico con codigo QR o de barras. Respondes EXCLUSIVAMENTE JSON: {\"numero_autorizacion\": string|null, \"practica\": string|null}.', messages: [ { role: 'user', content: [ { type: 'text', text: 'Extrae el texto relevante de este documento.' }, { type: 'image', source: { type: 'base64', media_type: $json.mime_type, data: $json.image_base64 } } ] } ] }) }}"
      },
      "id": "n116",
      "name": "Claude Vision - Leer texto adicional",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "\nreturn [{ json: { ...$input.first().json, extraccion: {} } }];\n"
      },
      "id": "n117",
      "name": "Sin extraccion especifica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nlet extraccion = {};\ntry {\n  const text = item.content?.[0]?.text;\n  if (text) {\n    const match = text.match(/\\{[\\s\\S]*\\}/);\n    extraccion = JSON.parse(match ? match[0] : text);\n  }\n} catch (e) {}\n\nconst base = $('Parsear clasificacion').first().json;\nreturn [{\n  json: {\n    telefono: base.telefono,\n    paciente: base.paciente,\n    tipo_documento: base.tipo_documento,\n    image_base64: base.image_base64,\n    mime_type: base.mime_type,\n    extraccion: Object.keys(extraccion).length ? extraccion : (item.extraccion || item.codigo_detectado ? { codigo: item.codigo_detectado } : {}),\n  }\n}];\n"
      },
