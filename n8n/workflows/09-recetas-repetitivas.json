      "id": "n151",
      "name": "Entrada: aprobacion del medico",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst match = (item.contenido || '').match(/APROBAR\\s+([a-f0-9-]+)/i);\nreturn [{ json: { ...item, pedido_id: match ? match[1] : null } }];\n"
      },
      "id": "n152",
      "name": "Parsear comando de aprobacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        620
      ]
    },
