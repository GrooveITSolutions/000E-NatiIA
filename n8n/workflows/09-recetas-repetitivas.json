              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: ={{$env.STAFF_WHATSAPP_NUMBER}}, text: ={{ `💊 Pedido de renovación\\nPaciente: ${$('Hay antecedente?').first().json.paciente.nombre_completo}\\nMedicamento: ${$('Hay antecedente?').first().json.medicamento.droga} ${$('Hay antecedente?').first().json.medicamento.mg || ''}\\n\\nPara aprobar respondé: APROBAR ${$json[0]?.id || $json.id}` }} }) }}"
      },
