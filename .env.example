# Copiar a variables de entorno de n8n (Settings > Environment variables,
# o el .env de tu instancia self-hosted). Nunca commitear el .env real.

# --- Evolution API (WhatsApp via Baileys) ---
EVOLUTION_API_URL=https://tu-evolution-api.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=natiia

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar ---
# El ID del calendario del consultorio (no requiere key propia: se usa
# credencial OAuth2 nativa de n8n en los nodos Google Calendar).
GOOGLE_CALENDAR_ID=consultorio@example.com

# --- Speech-to-Text (para audios de WhatsApp) ---
# Claude no transcribe audio. Conectar cualquier proveedor de STT
# (Whisper de OpenAI, Groq, Deepgram, etc.) en el nodo "Transcribir audio (STT)"
# del Flujo 00.
STT_API_URL=
STT_API_KEY=

# --- Staff ---
# Numero de WhatsApp de la secretaria/medico (formato E.164 sin '+'),
# usado por el Flujo 07 (Escalamiento) y el Flujo 09 (aprobar recetas).
STAFF_WHATSAPP_NUMBER=549xxxxxxxxxx
